local esp = {}
local function newESP()
    local d = {}
    d.box = newDraw("Square")
    d.boxFill = newDraw("Square")
    d.corner = {}
    for i=1,8 do d.corner[i] = newDraw("Line") end
    d.box3D = {}
    for i=1,12 do d.box3D[i] = newDraw("Line") end
    d.glowBox = newDraw("Square")
    d.hpBg = newDraw("Square")
    d.hpFill = newDraw("Square")
    d.hpOutline = newDraw("Square")
    d.hpText = newDraw("Text"); d.hpText.Size = 11; d.hpText.Center = false; d.hpText.Outline = true; d.hpText.Font = 2
    d.name = newDraw("Text"); d.name.Size = 13; d.name.Center = true; d.name.Outline = true; d.name.Font = 2
    d.dist = newDraw("Text"); d.dist.Size = 11; d.dist.Center = true; d.dist.Outline = true; d.dist.Font = 2
    d.tracer = newDraw("Line")
    d.skel = {}
    for i=1,16 do d.skel[i] = newDraw("Line") end
    d.head = newDraw("Circle")
    return d
end

local function removeESP(p)
    local d = esp[p]
    if not d then return end
    for _, o in pairs(d) do
        if typeof(o) == "table" then
            for _, s in pairs(o) do pcall(function() s:Remove() end) end
        else
            pcall(function() o:Remove() end)
        end
    end
    esp[p] = nil
end

local function addESP(p)
    if p == LP and not S.showLocal then return end
    if esp[p] then removeESP(p) end
    esp[p] = newESP()
end

for _, p in ipairs(Plrs:GetPlayers()) do addESP(p) end
Plrs.PlayerAdded:Connect(function(p) task.wait(0.3) addESP(p) end)
Plrs.PlayerRemoving:Connect(removeESP)

local R15 = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
}
local R6 = {
    {"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},
    {"Torso","Left Leg"},{"Torso","Right Leg"},
}

local function hide(d)
    for _, o in pairs(d) do
        if typeof(o) == "table" then
            for _, s in pairs(o) do s.Visible = false end
        else
            o.Visible = false
        end
    end
end

local hue = 0

RS.RenderStepped:Connect(function(dt)
    hue = (hue + dt*0.15) % 1
    local viewport = Cam.ViewportSize

    for p, d in pairs(esp) do
        local hideAll = false
        if not S.enabled then hideAll = true end
        if p == LP and not S.showLocal then hideAll = true end
        if S.teamCheck and LP.Team and p.Team == LP.Team then hideAll = true end

        local char = p.Character
        if not hideAll and (not char or not char.Parent) then hideAll = true end

        local hrp, head, hum
        if not hideAll then
            hrp = char:FindFirstChild("HumanoidRootPart")
            head = char:FindFirstChild("Head")
            hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not head or not hum or hum.Health <= 0 then hideAll = true end
        end

        if hideAll then hide(d) continue end

        local hPos, onH = Cam:WorldToViewportPoint(head.Position)
        local rPos, onR = Cam:WorldToViewportPoint(hrp.Position)
        local dist = (Cam.CFrame.Position - hrp.Position).Magnitude

        if not onH or not onR or hPos.Z <= 0 or dist > S.maxDist then hide(d) continue end

        local alpha = 1
        if S.fadeByDist then alpha = math.clamp(1 - (dist/S.maxDist)*0.8, 0.2, 1) end

        local baseCol
        if S.rainbow then
            baseCol = Color3.fromHSV(hue, 0.8, 1)
        else
            if LP.Team and p.Team then
                baseCol = (p.Team == LP.Team) and S.cAlly or S.cEnemy
            else
                baseCol = S.cNeutral
            end
        end

        local height = math.abs(hPos.Y - rPos.Y) * 2.15
        local width = height / 2
        local x = hPos.X - width/2
        local y = hPos.Y - height/8

        d.box.Visible = false
        d.boxFill.Visible = false
        for i=1,8 do d.corner[i].Visible = false end
        for i=1,12 do d.box3D[i].Visible = false end
        d.glowBox.Visible = false

        if S.box then
            if S.boxStyle == "2D" then
                d.box.Visible = true
                d.box.Position = Vector2.new(x, y)
                d.box.Size = Vector2.new(width, height)
                d.box.Color = baseCol
                d.box.Thickness = S.boxThick
                d.box.Transparency = alpha
            elseif S.boxStyle == "Corner" then
                local cl = math.min(width, height)/3.5
                local x1,x2,y1,y2 = x, x+width, y, y+height
                local segs = {
                    {x1,y1, x1+cl,y1}, {x1,y1, x1,y1+cl},
                    {x2,y1, x2-cl,y1}, {x2,y1, x2,y1+cl},
                    {x1,y2, x1+cl,y2}, {x1,y2, x1,y2-cl},
                    {x2,y2, x2-cl,y2}, {x2,y2, x2,y2-cl},
                }
                for i,s in ipairs(segs) do
                    local L = d.corner[i]
                    L.Visible = true
                    L.From = Vector2.new(s[1], s[2])
                    L.To = Vector2.new(s[3], s[4])
                    L.Color = baseCol
                    L.Thickness = S.boxThick + 1
                    L.Transparency = alpha
                end
            elseif S.boxStyle == "3D" then
                local cf = hrp.CFrame
                local sz = char:GetExtentsSize()/2
                local pts = {
                    cf*Vector3.new(-sz.X,-sz.Y,-sz.Z),
                    cf*Vector3.new( sz.X,-sz.Y,-sz.Z),
                    cf*Vector3.new(-sz.X, sz.Y,-sz.Z),
                    cf*Vector3.new( sz.X, sz.Y,-sz.Z),
                    cf*Vector3.new(-sz.X,-sz.Y, sz.Z),
                    cf*Vector3.new( sz.X,-sz.Y, sz.Z),
                    cf*Vector3.new(-sz.X, sz.Y, sz.Z),
                    cf*Vector3.new( sz.X, sz.Y, sz.Z),
                }
                local sp = {}
                for i,c in ipairs(pts) do
                    local v, on = Cam:WorldToViewportPoint(c)
                    if on and v.Z > 0 then sp[i] = Vector2.new(v.X, v.Y) else sp[i] = nil end
                end
                local edges = {
                    {1,2},{1,3},{1,5},{2,4},{2,6},{3,4},{3,7},
                    {4,8},{5,6},{5,7},{6,8},{7,8}
                }
                for i,e in ipairs(edges) do
                    local L = d.box3D[i]
                    if sp[e[1]] and sp[e[2]] then
                        L.Visible = true
                        L.From = sp[e[1]]
                        L.To = sp[e[2]]
                        L.Color = baseCol
                        L.Thickness = S.boxThick
                        L.Transparency = alpha
                    end
                end
            end

            if S.glow then
                d.glowBox.Visible = true
                d.glowBox.Position = Vector2.new(x-3, y-3)
                d.glowBox.Size = Vector2.new(width+6, height+6)
                d.glowBox.Color = baseCol
                d.glowBox.Thickness = 2
                d.glowBox.Filled = false
                d.glowBox.Transparency = alpha * 0.75
            end

            if S.boxFill then
                d.boxFill.Visible = true
                d.boxFill.Position = Vector2.new(x, y)
                d.boxFill.Size = Vector2.new(width, height)
                d.boxFill.Color = baseCol
                d.boxFill.Filled = true
                d.boxFill.Transparency = S.boxFillTrans
            end
        end

        local hp = hum.Health / hum.MaxHealth
        d.hpBg.Visible = false
        d.hpFill.Visible = false
        d.hpOutline.Visible = false
        d.hpText.Visible = false

        if S.health then
            local hx, hy, hw, hh
            if S.healthStyle == "Side" then
                hw, hh = 3, height
                hx, hy = x-7, y
            elseif S.healthStyle == "Top" then
                hw, hh = width, 3
                hx, hy = x, y-7
            else
                hw, hh = width, 3
                hx, hy = x, y+height+4
            end

            d.hpOutline.Visible = true
            d.hpOutline.Position = Vector2.new(hx-1, hy-1)
            d.hpOutline.Size = Vector2.new(hw+2, hh+2)
            d.hpOutline.Color = Color3.new(0,0,0)
            d.hpOutline.Filled = true
            d.hpOutline.Transparency = 0.3*alpha

            d.hpBg.Visible = true
            d.hpBg.Position = Vector2.new(hx, hy)
            d.hpBg.Size = Vector2.new(hw, hh)
            d.hpBg.Color = S.cHealthBg
            d.hpBg.Filled = true
            d.hpBg.Transparency = 0.2*alpha

            local hColor = rgbLerp(Color3.fromRGB(255,60,80), S.cHealth, hp)
            d.hpFill.Visible = true
            if S.healthStyle == "Side" then
                d.hpFill.Position = Vector2.new(hx, hy + hh*(1-hp))
                d.hpFill.Size = Vector2.new(hw, hh*hp)
            else
                d.hpFill.Position = Vector2.new(hx, hy)
                d.hpFill.Size = Vector2.new(hw*hp, hh)
            end
            d.hpFill.Color = hColor
            d.hpFill.Filled = true
            d.hpFill.Transparency = 0.05*alpha

            if S.healthText and S.healthStyle ~= "Side" then
                d.hpText.Visible = true
                d.hpText.Text = string.format("%d", math.floor(hum.Health))
                d.hpText.Position = Vector2.new(hx + hw + 4, hy - 2)
                d.hpText.Color = hColor
                d.hpText.Transparency = alpha
            end
        end

        d.name.Visible = S.name
        if S.name then
            local nstr = p.Name
            if S.nameHealth then nstr = nstr .. "  [" .. math.floor(hp*100) .. "%]" end
            if S.nameDist then
                local unit = S.distUnit == "m" and (dist/3) or dist
                nstr = nstr .. "  (" .. math.floor(unit) .. (S.distUnit=="m" and "m" or "") .. ")"
            end
            if p.Team then nstr = nstr .. "  " .. p.Team.Name end
            d.name.Text = nstr
            d.name.Position = Vector2.new(hPos.X, y - 20)
            d.name.Color = S.cName
            d.name.Transparency = alpha
        end

        d.dist.Visible = S.dist
        if S.dist then
            local unit = S.distUnit == "m" and (dist/3) or dist
            d.dist.Text = string.format("[%d%s]", math.floor(unit), S.distUnit == "m" and "m" or "")
            d.dist.Position = Vector2.new(hPos.X, y + height + 4)
            d.dist.Color = S.cDist
            d.dist.Transparency = alpha
        end

        d.tracer.Visible = S.tracer
        if S.tracer then
            local fx, fy
            if S.tracerOrigin == "Bottom" then fx, fy = viewport.X/2, viewport.Y
            elseif S.tracerOrigin == "Top" then fx, fy = viewport.X/2, 0
            elseif S.tracerOrigin == "Center" then fx, fy = viewport.X/2, viewport.Y/2
            else local m = UIS:GetMouseLocation(); fx, fy = m.X, m.Y end
            d.tracer.From = Vector2.new(fx, fy)
            d.tracer.To = Vector2.new(hPos.X, y + height/2)
            d.tracer.Color = S.cTracer
            d.tracer.Thickness = 1
            d.tracer.Transparency = alpha*0.85
        end

        for i=1,16 do d.skel[i].Visible = false end
        if S.skeleton then
            local bones = (hum.RigType == Enum.HumanoidRigType.R15) and R15 or R6
            for i,b in ipairs(bones) do
                local a = char:FindFirstChild(b[1])
                local c = char:FindFirstChild(b[2])
                if a and c and i <= 16 then
                    local ap, onA = Cam:WorldToViewportPoint(a.Position)
                    local cp, onC = Cam:WorldToViewportPoint(c.Position)
                    if onA and onC and ap.Z > 0 and cp.Z > 0 then
                        local L = d.skel[i]
                        L.Visible = true
                        L.From = Vector2.new(ap.X, ap.Y)
                        L.To = Vector2.new(cp.X, cp.Y)
                        L.Color = S.cSkel
                        L.Thickness = S.skelThick
                        L.Transparency = alpha*0.9
                    end
                end
            end
        end

        d.head.Visible = S.headDot
        if S.headDot then
            d.head.Position = Vector2.new(hPos.X, hPos.Y)
            d.head.Radius = S.headDotSize
            d.head.NumSides = 24
            d.head.Filled = true
            d.head.Color = S.cHead
            d.head.Transparency = alpha
        end
    end
end)

