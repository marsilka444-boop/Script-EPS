local function newDraw(kind)
    local o = Drawing.new(kind)
    o.Visible = false
    o.Transparency = 1
    return o
end

local function rgbLerp(a,b,t)
    return Color3.new(a.R+(b.R-a.R)*t, a.G+(b.G-a.G)*t, a.B+(b.B-a.B)*t)
end

local function lerp(a,b,t) return a+(b-a)*t end

